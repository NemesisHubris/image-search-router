{
  "manifest_version": 3,
  "name": "Image Search for Brave",
  "version": "1.2.0",
  "description": "Use Google, Bing, DuckDuckGo, or your own image search engine from Brave Search. Opens in a new tab.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Image Search for Brave",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://search.brave.com/*"],
      "js": ["engines.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
