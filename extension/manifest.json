{
  "manifest_version": 3,
  "name": "Google Images for Brave Search",
  "version": "1.1.0",
  "description": "Open Brave Search's Images tab in a new Google Images tab, keeping your Brave results open.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Google Images for Brave Search",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://search.brave.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
